# Supabase local stack (custom ports, see supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# anon key from `supabase status` — paste yours, do not commit a real key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: local Google OAuth (only needed to test the Google provider locally).
# Without these, use the dev login button at /entrar.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
